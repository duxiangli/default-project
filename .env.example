# 自主派单 watcher 配置样例 —— 复制为 .env 填入后生效（.env 已在 .gitignore，勿入库）
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-XXXXXXXXXXXXXXXX

# 可选：只监听指定项目（GitLab 项目 ID 或 URL 编码的项目路径）
# GITLAB_PROJECT_ID=123456

# 可选：自定义仓库目录 / 状态文件（默认见脚本注释）
# AUTODISPATCH_DIR=C:/Users/you/repo
# AUTODISPATCH_STATE=C:/Users/you/AppData/Roaming/ai.opencode.desktop/autodispatch-state.json